{
  "$schema": "https://pg-language-server.com/0.25.0/schema.json",
  "extends": [],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "splinter": {
    "enabled": true
  },
  "typecheck": {
    "enabled": true
  },
  "plpgsqlCheck": {
    "enabled": true
  },
  "format": {
    "enabled": true
  },
  "pglinter": {
    "enabled": false
  },
  "db": {
    "connTimeoutSecs": 10,
    "disableConnection": false
  }
}
